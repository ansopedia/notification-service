{
  "name": "notification-service",
  "version": "1.3.0",
  "description": "notification service for ansopedia",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "local": "nodemon",
    "email": "email dev --dir src/emails",
    "email:build": "email export --dir src/emails",
    "lint": "eslint src .",
    "lint:fix": "eslint --fix .",
    "pretest": "pnpm build",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prod": "set NODE_ENV=production&& pnpm build && pnpm start",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "prepare": "husky"
  },
  "keywords": [
    "notification service",
    "ansopedia"
  ],
  "author": "sanjay kumar sah",
  "license": "ISC",
  "dependencies": {
    "@ansospace/eslint-config": "file://F:\\projects\\ansospace\\packages\\eslint-config",
    "@ansospace/types": "file://F:\\projects\\ansospace\\packages\\types",
    "@react-email/components": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "nodemailer": "7.0.12",
    "pino": "10.1.0",
    "react": "19.2.3",
    "react-email": "5.1.1",
    "zod": "4.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@react-email/preview-server": "5.1.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "nodemon": "3.1.11",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwind-merge": "3.4.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,md}": [
      "prettier --write .",
      "eslint --fix ."
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.27.0"
}
